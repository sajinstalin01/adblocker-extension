{
  "manifest_version": 3,
  "name": "Rolex Key AdBlocker",
  "version": "4.2.0",
  "description": "Advanced ad blocking with local analytics, element rules, diagnostics and configurable page cleanup.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "Rolex Key AdBlocker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-live-ad-blocker.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-ad-cleaner.js",
        "content-features.js",
        "content-streaming-cleaner.js",
        "content-youtube.js",
        "advanced-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "base_ads",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "base_trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      },
      {
        "id": "base_privacy",
        "enabled": true,
        "path": "rules/privacy.json"
      },
      {
        "id": "base_mining",
        "enabled": false,
        "path": "rules/miners.json"
      }
    ]
  },
  "options_page": "options.html",
  "minimum_chrome_version": "121",
  "commands": {
    "toggle-reading-mode": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Toggle reading mode on the current website"
    }
  },
  "optional_permissions": [
    "notifications"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
