{
  "manifest_version": 3,
  "name": "Rolex Key AdBlocker",
  "version": "3.5.0",
  "description": "Cross-site ad blocking with YouTube Shorts controls, streaming cleanup, automatic update checks, browser compatibility guidance and optional local settings lock.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "Rolex Key AdBlocker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-ad-cleaner.js",
        "content-features.js",
        "content-streaming-cleaner.js",
        "content-youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "base_ads",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "base_trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      },
      {
        "id": "base_privacy",
        "enabled": true,
        "path": "rules/privacy.json"
      }
    ]
  },
  "options_page": "options.html",
  "minimum_chrome_version": "121",
  "commands": {
    "toggle-reading-mode": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Toggle reading mode on the current website"
    }
  },
  "optional_permissions": [
    "notifications"
  ]
}
